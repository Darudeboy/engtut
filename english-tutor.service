[Unit]
Description=English Tutor Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/english-tutor-bot
EnvironmentFile=/opt/english-tutor-bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/english-tutor-bot/venv/bin/python -m bot.main
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
