# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# DeepSeek API key from https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional overrides
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DATABASE_PATH=data/english_tutor.db
# Neon/PostgreSQL connection string. When set, it takes priority over SQLite.
DATABASE_URL=
LOG_LEVEL=INFO

# Vocabulary pacing: 5-word batches, up to 15 new words per day
NEW_WORDS_PER_BATCH=5
MAX_NEW_WORDS_PER_DAY=15
REVIEW_WORDS_PER_SESSION=5

# Proxy for Telegram API (if api.telegram.org is blocked)
# Examples:
# BOT_PROXY=socks5://127.0.0.1:1080
# BOT_PROXY=http://127.0.0.1:8080
BOT_PROXY=

# Webhook mode (Render Web Service)
# Render provides RENDER_EXTERNAL_URL automatically.
# Set WEBHOOK_BASE_URL only for another hosting provider or a custom domain.
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
